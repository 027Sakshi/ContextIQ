# ContextIQ runtime
CONTEXTIQ_ENV=development
CONTEXTIQ_API_URL=http://127.0.0.1:8000

# Local development bridge only. Google verified auth replaces this in Milestone 2.
ALLOW_DEV_USER_HEADER=false
ALLOW_DEV_EMAIL_LOGIN=true

# Optional. If omitted, ContextIQ uses data/contextiq.db (SQLite).
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/contextiq

# Demo/seed workspace
DEMO_USER_EMAIL=demo@contextiq.local

# Gemini (optional: the app keeps a local fallback when unset)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Google sign-in callback (Milestone 2)
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8501

# Signed ContextIQ browser/API session. Replace before deployment.
CONTEXTIQ_SESSION_SECRET=replace-with-a-long-random-secret
CONTEXTIQ_SESSION_TTL_SECONDS=43200

# Optional alternative to credentials/google_oauth_client.json
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gemini latency guardrails. ContextIQ falls back to local intelligence if the API is slow/unavailable.
GEMINI_TIMEOUT_SECONDS=18
GEMINI_THINKING_LEVEL=low

# Direct workspace sign-in
ALLOW_DIRECT_EMAIL_LOGIN=true
CONTEXTIQ_DIRECT_LOGIN_CODE=
